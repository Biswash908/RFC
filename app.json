{
  "expo": {
    "name": "Raw Feeding Calc for Dogs",
    "slug": "make-things-unlimited-dog-calc",
    "version": "1.2.5",
    "orientation": "default",
    "icon": "./assets/iconD.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "updates": {
