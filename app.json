    },
    "androidStatusBar": {
      "translucent": true,
      "barStyle": "dark-content",
      "backgroundColor": "transparent"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d7f4197f-2487-43be-b10b-95974d5ae27a"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
